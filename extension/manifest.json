{
  "manifest_version": 3,
  "name": "마켓 판매 점검 도우미",
  "version": "0.1.0",
  "description": "마켓 판매 점검 페이지가 요청한 상품 페이지를 이 크롬에서 열어 판매 상태와 가격을 읽어 옵니다.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://item.gmarket.co.kr/*",
    "https://itempage3.auction.co.kr/*",
    "https://itempage.auction.co.kr/*",
    "https://www.superstore.co.kr/*",
    "https://www.e-himart.co.kr/*",
    "https://brand.naver.com/*",
    "https://smartstore.naver.com/*",
    "https://www.coupang.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://kwondohoon1.github.io/market-sale-check/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
